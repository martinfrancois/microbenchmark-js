{
  "name": "js-performance-bench",
  "version": "1.0.0",
  "description": "A small TypeScript benchmark template using Tinybench.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "bench": "npm run build && node dist/index.js",
    "bench:smoke": "npm run bench -- --smoke",
    "start": "npm run bench",
    "check": "npm run typecheck && npm test && npm run bench:smoke"
  },
  "author": "François Martin",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "24.13.4",
    "tinybench": "6.2.0",
    "typescript": "7.0.2"
  }
}
